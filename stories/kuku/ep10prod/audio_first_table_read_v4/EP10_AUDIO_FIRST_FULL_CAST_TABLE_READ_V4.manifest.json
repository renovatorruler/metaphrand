 "sfx_assembly_status": "all 22 validated local guide SFX inserted in screenplay order; none generated by renderer",
 "available_local_guide_sfx": 22,
 "ordered_sfx_cues": [
  {
   "order": 5,
   "scene": 0,
   "kind": "sfx",
   "text": "बड़े पंख हवा काटते हैं। घंटी साफ़ टनकती है।",
   "sfx_idx": 1,
   "after_dialogue_idx": 4,
   "before_dialogue_idx": 5,
   "placeholder_ms": 1800,
   "cue_signature_sha256": "4af2449fbfd3319016f4c6248660a2a9692c00c2ab9db183714625e338edb96c",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_001_4af2449fbfd3319016f4c6248660a2a9692c00c2ab9db183714625e338edb96c.mp3",
   "spoken": false
  },
  {
   "order": 7,
   "scene": 0,
   "kind": "sfx",
   "text": "फ्यूरिया के पंख धीमे होते हैं और उसके पैर जमीन पर उतरते हैं।",
   "sfx_idx": 2,
   "after_dialogue_idx": 5,
   "before_dialogue_idx": 6,
   "placeholder_ms": 1600,
   "cue_signature_sha256": "b7c99c506e5a5aedf098807bad76e3162e9ee3dfaa40d1d2b822410d18194430",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_002_b7c99c506e5a5aedf098807bad76e3162e9ee3dfaa40d1d2b822410d18194430.mp3",
   "spoken": false
  },
  {
   "order": 10,
   "scene": 0,
   "kind": "sfx",
   "text": "गाँठ तेजी से सरकती है। मोटी रस्सी पत्थर पर गिरती है। लकड़ी के पहिए पहले धीरे और फिर तेजी से घूमते हैं। गाय घबराकर रंभाती है।",
   "sfx_idx": 3,
   "after_dialogue_idx": 7,
   "before_dialogue_idx": 8,
   "placeholder_ms": 3200,
   "cue_signature_sha256": "265e4bfe5a309b9092f140dbe255b64daaf7a91b747f41f7cca9288b7f62c85e",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_003_265e4bfe5a309b9092f140dbe255b64daaf7a91b747f41f7cca9288b7f62c85e.mp3",
   "spoken": false
  },
  {
   "order": 12,
   "scene": 0,
   "kind": "sfx",
   "text": "काँसे का बंधन खुलता है। घंटी चील के पंजों में खनकती है। बड़े पंख ऊपर उठते हैं।",
   "sfx_idx": 4,
   "after_dialogue_idx": 8,
   "before_dialogue_idx": 9,
   "placeholder_ms": 2200,
   "cue_signature_sha256": "c880bb9ce94a9c0fae94732cc4474821064927e08fd59d96ae2677d8900c1094",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_004_c880bb9ce94a9c0fae94732cc4474821064927e08fd59d96ae2677d8900c1094.mp3",
   "spoken": false
  },
  {
   "order": 22,
   "scene": 1,
   "kind": "sfx",
   "text": "फ्यूरिया के पंख तेज़ी से हवा धकेलते हैं। पहियों की रफ्तार थोड़ी घटती है, मगर वे चलते रहते हैं।",
   "sfx_idx": 5,
   "after_dialogue_idx": 16,
   "before_dialogue_idx": 17,
   "placeholder_ms": 2200,
   "cue_signature_sha256": "01ebdfca3b09aad5789e97fd17d16ed5b4e5c72e7b947bb13187eb000726d6d5",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_005_01ebdfca3b09aad5789e97fd17d16ed5b4e5c72e7b947bb13187eb000726d6d5.mp3",
   "spoken": false
  },
  {
   "order": 26,
   "scene": 1,
   "kind": "sfx",
   "text": "लकड़ी का फाटक जोर से खटखटाता है, फिर बंद होकर अटक जाता है।",
   "sfx_idx": 6,
   "after_dialogue_idx": 19,
   "before_dialogue_idx": 20,
   "placeholder_ms": 1600,
   "cue_signature_sha256": "16398f69b30a56657b660c594e5d5bae6c127f9cb5b8f09a195cd69451e0a680",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_006_16398f69b30a56657b660c594e5d5bae6c127f9cb5b8f09a195cd69451e0a680.mp3",
   "spoken": false
  },
  {
   "order": 31,
   "scene": 2,
   "kind": "sfx",
   "text": "एक लाल निशान पत्थर में ठक से लगता है। फिर दूर दूसरा निशान ठक से लगता है।",
   "sfx_idx": 7,
   "after_dialogue_idx": 23,
   "before_dialogue_idx": 24,
   "placeholder_ms": 1400,
   "cue_signature_sha256": "a3272326c6210671b67c6983edd6ab71ac4170683077c07a75ad85e37cd69d92",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_007_a3272326c6210671b67c6983edd6ab71ac4170683077c07a75ad85e37cd69d92.mp3",
   "spoken": false
  },
  {
   "order": 34,
   "scene": 2,
   "kind": "sfx",
   "text": "“गाड़ी” की पहली ग पर एक छोटी सुनहरी टनन।",
   "sfx_idx": 8,
   "after_dialogue_idx": 25,
   "before_dialogue_idx": 26,
   "placeholder_ms": 650,
   "cue_signature_sha256": "7c429b807ef5f3a65c618b291f90d634b969559e4e00296bd4573c72b599e30a",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_008_7c429b807ef5f3a65c618b291f90d634b969559e4e00296bd4573c72b599e30a.mp3",
   "spoken": false,
   "timing_limitation": "table-read guide is inserted immediately after the isolated source line; final word-onset placement requires line-level alignment"
  },
  {
   "order": 36,
   "scene": 2,
   "kind": "sfx",
   "text": "“गाय” की पहली ग पर वही छोटी सुनहरी टनन।",
   "sfx_idx": 9,
   "after_dialogue_idx": 26,
   "before_dialogue_idx": 27,
   "placeholder_ms": 650,
   "cue_signature_sha256": "22becc539d2ee2e073293c0984714527b65f32c5d54dcc79bffb8a9885f54d06",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_009_22becc539d2ee2e073293c0984714527b65f32c5d54dcc79bffb8a9885f54d06.mp3",
   "spoken": false,
   "timing_limitation": "table-read guide is inserted immediately after the isolated source line; final word-onset placement requires line-level alignment"
  },
  {
   "order": 38,
   "scene": 2,
   "kind": "sfx",
   "text": "“गाड़ी” और “गुरुकुल” की पहली ग पर वही छोटी सुनहरी टनन।",
   "sfx_idx": 10,
   "after_dialogue_idx": 27,
   "before_dialogue_idx": 28,
   "placeholder_ms": 950,
   "cue_signature_sha256": "91095ed10e45f6ecd188b4c6ea45018f87f9482f9bf9570d2fab5aedbaf1f65e",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_010_91095ed10e45f6ecd188b4c6ea45018f87f9482f9bf9570d2fab5aedbaf1f65e.mp3",
   "spoken": false,
   "timing_limitation": "table-read guide is inserted immediately after the isolated source line; final word-onset placement requires line-level alignment"
  },
  {
   "order": 43,
   "scene": 2,
   "kind": "sfx",
   "text": "कुकु की गहरी साँस। तीन सुनहरी रेखाएँ गूँजते हुए जुड़ती हैं। पूरा ग पत्थर में भारी ठक से बैठता है।",
   "sfx_idx": 11,
   "after_dialogue_idx": 31,
   "before_dialogue_idx": 32,
   "placeholder_ms": 2600,
   "cue_signature_sha256": "67a84a8be941fc28988121c8ee10b573079270b07b56d4785913fecd8b78ef07",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_011_67a84a8be941fc28988121c8ee10b573079270b07b56d4785913fecd8b78ef07.mp3",
   "spoken": false
  },
  {
   "order": 46,
   "scene": 2,
   "kind": "sfx",
   "text": "पाँच कड़ों की पाँच हल्की टनन।",
   "sfx_idx": 12,
   "after_dialogue_idx": 33,
   "before_dialogue_idx": 34,
   "placeholder_ms": 1400,
   "cue_signature_sha256": "aeb8012e07d0351cde14925f1cafdb818115b664257dbeff1865c15688479e88",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_012_aeb8012e07d0351cde14925f1cafdb818115b664257dbeff1865c15688479e88.mp3",
   "spoken": false
  },
  {
   "order": 54,
   "scene": 3,
   "kind": "sfx",
   "text": "लकड़ी के पहिए पत्थर से सुनहरी सतह पर चढ़ते हैं। उनकी आवाज़ साफ़ बदलती है।",
   "sfx_idx": 13,
   "after_dialogue_idx": 40,
   "before_dialogue_idx": 41,
   "placeholder_ms": 1800,
   "cue_signature_sha256": "89c34ec456b3b2bf2f870a336e4d4f90a45b6667e4beceb05157eecf77b66536",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_013_89c34ec456b3b2bf2f870a336e4d4f90a45b6667e4beceb05157eecf77b66536.mp3",
   "spoken": false
  },
  {
   "order": 56,
   "scene": 3,
   "kind": "sfx",
   "text": "दो और पहिए सुनहरी सतह पर चढ़ते हैं।",
   "sfx_idx": 14,
   "after_dialogue_idx": 41,
   "before_dialogue_idx": 42,
   "placeholder_ms": 1000,
   "cue_signature_sha256": "ee9da4957b58f2b0d38d4d7d721cc1a0e89a84b0e204d8b8da3de51310e6093e",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_014_ee9da4957b58f2b0d38d4d7d721cc1a0e89a84b0e204d8b8da3de51310e6093e.mp3",
   "spoken": false
  },
  {
   "order": 58,
   "scene": 3,
   "kind": "sfx",
   "text": "ऊपर चील के पंख गुजरते हैं। उसके पंजों में चोरी की घंटी झनकती हुई दूर जाती है।",
   "sfx_idx": 15,
   "after_dialogue_idx": 42,
   "before_dialogue_idx": 43,
   "placeholder_ms": 2200,
   "cue_signature_sha256": "87f2c75fa1a32312fcd37f2deb8a94e956e28f1aade947d46ee23b821cdc74a2",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_015_87f2c75fa1a32312fcd37f2deb8a94e956e28f1aade947d46ee23b821cdc74a2.mp3",
   "spoken": false
  },
  {
   "order": 63,
   "scene": 3,
   "kind": "sfx",
   "text": "पहिए धीमे होते हैं और रुक जाते हैं। गाय लंबी राहत की साँस छोड़ती है।",
   "sfx_idx": 16,
   "after_dialogue_idx": 46,
   "before_dialogue_idx": 47,
   "placeholder_ms": 2200,
   "cue_signature_sha256": "36724c9e10920c6c36e32379bc63fc10597c7c4ad91633a14597191a5b3b51c2",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_016_36724c9e10920c6c36e32379bc63fc10597c7c4ad91633a14597191a5b3b51c2.mp3",
   "spoken": false
  },
  {
   "order": 69,
   "scene": 4,
   "kind": "sfx",
   "text": "पाँच कड़ों की पाँच अलग टनन। पाँच नरम सुनहरी लहरें एक-एक करके शांत होती हैं।",
   "sfx_idx": 17,
   "after_dialogue_idx": 51,
   "before_dialogue_idx": 52,
   "placeholder_ms": 2200,
   "cue_signature_sha256": "59befccc8b0dd2281b7f9e8b70c732410a992901d41cf590343b72646d52fc66",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_017_59befccc8b0dd2281b7f9e8b70c732410a992901d41cf590343b72646d52fc66.mp3",
   "spoken": false
  },
  {
   "order": 72,
   "scene": 4,
   "kind": "sfx",
   "text": "गाय नरमी से रंभाती है। कैस्टर सूखी घास पर धप से बैठता है।",
   "sfx_idx": 18,
   "after_dialogue_idx": 53,
   "before_dialogue_idx": 54,
   "placeholder_ms": 1600,
   "cue_signature_sha256": "ddcb9da4964cc65b9f34ae6d260d503634a0f5fd9bde1b5a6b861506ad0bd605",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_018_ddcb9da4964cc65b9f34ae6d260d503634a0f5fd9bde1b5a6b861506ad0bd605.mp3",
   "spoken": false
  },
  {
   "order": 76,
   "scene": 4,
   "kind": "sfx",
   "text": "घर-वापसी की डोर की छोटी दो-सुरी झंकार। दादी की आवाज़ हल्की दूर से आती है।",
   "sfx_idx": 19,
   "after_dialogue_idx": 56,
   "before_dialogue_idx": 57,
   "placeholder_ms": 1800,
   "cue_signature_sha256": "d2327af5ced11fdcf58cfd7c8f4c99cafbb1b350e5f05f887ae0bf39bfc2507e",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_019_d2327af5ced11fdcf58cfd7c8f4c99cafbb1b350e5f05f887ae0bf39bfc2507e.mp3",
   "spoken": false
  },
  {
   "order": 79,
   "scene": 4,
   "kind": "sfx",
   "text": "पत्थर की छोटी कुंडी खुलती है। गाय के खुर पत्थर से घास पर उतरते हैं।",
   "sfx_idx": 20,
   "after_dialogue_idx": 58,
   "before_dialogue_idx": 59,
   "placeholder_ms": 1800,
   "cue_signature_sha256": "a9a6da52f2c92c2a6eb65ab99ab6c74d0f294fddf59a2ce3e8a99297c0117759",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_020_a9a6da52f2c92c2a6eb65ab99ab6c74d0f294fddf59a2ce3e8a99297c0117759.mp3",
   "spoken": false
  },
  {
   "order": 84,
   "scene": 5,
   "kind": "sfx",
   "text": "बड़े पंख पत्थर के पास रुकते हैं। चील के पंजे मीनार पर खुरचते हैं। चोरी की घंटी हल्के से खनकती है।",
   "sfx_idx": 21,
   "after_dialogue_idx": 62,
   "before_dialogue_idx": 63,
   "placeholder_ms": 2300,
   "cue_signature_sha256": "b8a41050a9805ee92e985ec97c85a1a14300c310d5cdd9a29324939a3d0e9486",
   "local_guide_path": "../stories/kuku/ep10prod/audio_first_table_read_v4/guide_sfx/cue_021_b8a41050a9805ee92e985ec97c85a1a14300c310d5cdd9a29324939a3d0e9486.mp3",
   "spoken": false
  },
  {
   "order": 86,
   "scene": 5,
   "kind": "sfx",
   "text": "चील घंटी की डोरी पीछे खींचती है। काँसा हल्का काँपता है। पूरी टनक से ठीक पहले कट।",
   "sfx_idx": 22,
   "after_dialogue_idx": 63,
   "before_dialogue_idx": 64,
