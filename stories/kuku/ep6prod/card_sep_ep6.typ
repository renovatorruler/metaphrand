// Act-break card. Deliberately NOT t1 — t1 says «आज का अक्षर» and opens the
// episode; repeating that mid-story would read as starting over. This is the same
// letter on the same paper with nothing else on it, so it lands as a breath
// between acts while still putting त in front of the child one more time.
#set page(width: 1280pt, height: 720pt, margin: 0pt, fill: rgb("f7f2e6"))
#set text(font: "Kohinoor Devanagari")
#let gold = rgb("c07f00")
#page[#place(center + horizon)[#align(center)[
  #text(size: 260pt, fill: gold, weight: "bold")[त]
]]]
