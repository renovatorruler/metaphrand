  "greedy_transcript": "अक्षर तुम बनाते हो बाकी चार तुम्हारी मदद कर सकते हैंकू फ्यूरिया वैसपर कैस्टर और लीडा घेरे को बराबर जगह से पकड़ते हैं उसमें पांच सुनहरी लहरें दौड़ती हैं वो चमकता है पर खुलता नहं ",
  "segments": [
    {
      "order": 120,
      "text": "अक्षर तुम बनाते हो। बाकी चार तुम्हारी मदद कर सकते हैं।",
      "expected_words": 11,
      "start": 0.12014943960149438,
