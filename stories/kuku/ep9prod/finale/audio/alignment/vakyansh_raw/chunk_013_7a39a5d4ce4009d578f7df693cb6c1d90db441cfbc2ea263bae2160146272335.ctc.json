  "greedy_transcript": "कोको गहरी सांस लेकर सुनहरी व छोड़ता है मिट्टी प बना आकर उताहैऔूा चमकता हु बन जता ह  त गुरुु्र ितना बड़ा हो ाता ह ाग गड़ा रहता हैाी हैहै",
  "segments": [
    {
      "order": 151,
      "text": "कुकु गहरी साँस लेकर सुनहरी हवा छोड़ता है। मिट्टी पर बना आकार उठता है और एक पूरा, मोटा, चमकता हुआ ब बन जाता है। वह बढ़ते-बढ़ते गुरुकुल के टूटे द्वार जितना बड़ा हो जाता है।",
      "expected_words": 36,
      "start": 0.06007782101167315,
      "end": 14.93935149156939,
      "duration": 14.879273670557717,
      "mean_character_probability": 0.5267733495236387,
      "minimum_character_probability": 0.020254238993660714
    },
    {
      "order": 152,
      "text": "वही बड़ा ब आँगन के आगे खड़ा रहता है। केवल उसकी रोशनी पाँचों कड़ों में जाती है। हर खाली कड़े पर अब ब चमकता है।",
      "expected_words": 25,
      "start": 15.840518806744488,
      "end": 25.613177691309986,
      "duration": 9.772658884565498,
      "mean_character_probability": 0.3277942878637831,
      "minimum_character_probability": 0.0051339293155469425
    },
    {
      "order": 153,
      "text": "ब मेरे कड़े में चमक रहा है। बड़ा ब भी वहीं खड़ा है।",
      "expected_words": 13,
