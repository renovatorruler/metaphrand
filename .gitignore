__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# local secrets / API keys
.env

# per-render caches (ephemeral; regenerated every render — NOT versioned)
*_rs/
.DS_Store

# generated media — NOT versioned (regenerable; deliverables live on YouTube or get sent
# directly to the user; NEVER Git LFS — that hit the free-tier push cap once already and
# nearly lost work; source of truth is the scene text + the studio engine)
*.png
*.jpg
*.jpeg
*.webp
*.mp3
*.mp4
*.m4a
*.wav
*.glb
*.pdf

# git worktrees live here; never tracked by the parent repo
.claude/worktrees/
*.audio

# binary working assets / local databases / archives — regenerable, never versioned
*.blend
*.blend1
*.db
*.sqlite
*.zip
*.tsv.gz

# nothing is hard-deleted — removed files move here, structured by original path;
# reclaiming space is a manual per-project sweep (see studio/scripts/trash.sh --report)
.trash/

# binaries — never commit, never LFS
*.jar

# built artefacts — regenerable, never commit
game_dist_mac/
tools/*.jar
*.jar
# generated storyboards — regenerable from production/tools/panels*.py
stories/drakosha/production/kuku_flow/boards/*_v*.jpg

# 3D models — regenerable from the receipt, never commit
stories/drakosha/production/tripo3d/**/*.glb
