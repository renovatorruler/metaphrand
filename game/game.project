[project]
title = Frosya i Vasya
version = 0.1
publisher = Riften
developer = Riften

[bootstrap]
main_collection = /main/main.collectionc

[display]
width = 1280
height = 720
high_dpi = 1
samples = 4

[physics]
type = 2D

[collection]
max_instances = 6000

[sprite]
max_count = 6000

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[html5]
htmlfile = /web/engine_template.html
scale_mode = fit

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
